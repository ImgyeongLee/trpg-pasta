  "description": "TRPG 게임 매니저(GM)를 위한 데스크탑 도구 모음",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "node scripts/copy-pdfjs-assets.mjs && (svelte-kit sync || echo '')",
